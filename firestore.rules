rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId));
    }

    function validUserCreate(userId) {
      return request.resource.data.keys().hasAll([
          'uid', 'email', 'plan', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'nombre', 'apellido', 'photoURL',
          'plan', 'exportsUsed', 'ordersUsed', 'movementsUsed', 'createdAt', 'preferences'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.plan == 'free'
        && request.resource.data.get('exportsUsed', 0) == 0
        && request.resource.data.get('ordersUsed', 0) == 0
        && request.resource.data.get('movementsUsed', 0) == 0;
    }

    function validUserUpdate(userId) {
      return request.resource.data.get('uid', userId) == userId
        && request.resource.data.get('plan', resource.data.get('plan', null))
          == resource.data.get('plan', null)
        && request.resource.data.get('createdAt', resource.data.get('createdAt', null))
          == resource.data.get('createdAt', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'email', 'nombre', 'apellido', 'photoURL',
          'preferences'
        ]);
    }

    match /users/{userId} {
      // El lock bloquea tanto lecturas como escrituras directas durante la eliminación.
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && validUserCreate(userId);
      allow update: if isOwner(userId) && validUserUpdate(userId);
      allow delete: if false;

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow update, delete: if false;
      }

      match /operations/{operationId} {
        allow read, update, delete: if isOwner(userId);
      }

      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // Las funciones de servidor usan una cuenta de servicio y gestionan sus propias rutas.
    // Los clientes no pueden acceder a bloqueos, índices globales ni colecciones privadas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
